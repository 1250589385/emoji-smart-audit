{
  "manifest_version": 2,
  "id": "1250589385.emoji-smart-audit",
  "version": "1.0.0",
  "name": "表情包智能审核",
  "description": "发送前用视觉模型真正看懂表情包内容，再结合最近聊天语境判断配不配这句话；不合适就撤掉表情只发文字。自动适配宿主的视觉模型，任何异常都放行不影响正常说话。",
  "author": {
    "name": "1250589385",
    "url": "https://github.com/1250589385"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/1250589385/emoji-smart-audit",
    "homepage": "https://github.com/1250589385/emoji-smart-audit",
    "documentation": "https://github.com/1250589385/emoji-smart-audit",
    "issues": "https://github.com/1250589385/emoji-smart-audit/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.4.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "chat",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "smile",
      "fallback": "package"
    }
  },
  "capabilities": [
    "message.get_recent",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
