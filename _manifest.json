{
  "manifest_version": 2,
  "id": "1250589385.emoji-smart-audit",
  "version": "1.1.1",
  "name": "表情包智能审核",
  "description": "表情包审核插件：发送前先让视觉模型真正看懂表情包、表情图、配图的实际含义，再结合最近聊天语境判断它配不配这句话，不合适就撤掉表情只发文字，避免在安慰、严肃、难过场合发出无语调侃表情。同时清理机器人文本里自带的笑哭类 emoji（😂🤣😅），单独开关。自动适配宿主可用的视觉模型，任何异常都放行，不影响正常说话，不新增任何依赖。支持按语境过滤表情包、审核表情包内容、判断表情包合不合适、清理 emoji。",
  "author": {
    "name": "1250589385",
    "url": "https://github.com/1250589385"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/1250589385/emoji-smart-audit",
    "homepage": "https://github.com/1250589385/emoji-smart-audit",
    "documentation": "https://github.com/1250589385/emoji-smart-audit",
    "issues": "https://github.com/1250589385/emoji-smart-audit/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.4.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "chat",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "smile",
      "fallback": "package"
    }
  },
  "capabilities": [
    "message.get_recent",
    "llm.generate"
  ],
  "changelog": "CHANGELOG.md",
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
